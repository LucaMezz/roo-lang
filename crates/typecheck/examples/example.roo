type Number = int;
pub type Double<T, U> = (T, U);

fn add(a, b) -> Double<_, _> {
    (a, b as String)
}

// An identity function which has no type annotations that
// will be inferred as generic over a type parameter T.
fn identity(x) -> _ {
    x
}

#[entry]
pub fn main() {
    let n: Number = 5;
    let sum = add(n, 10);
    let doubled = identity::<Double<any, _> >(sum);
    let hello = identity("Hello");
    let ratio = doubled as float;
    let pair = (sum, doubled);
    let nums = [1, 2, 3];
    if true {
        doubled
    } else {
        return 0;
    }
}
