
trait Zero {
    fn zero() -> Self;
}

trait Add<Rhs = Self> {
    type Output;

    fn add(self, other: Rhs) -> Output;
}

impl Add for int {
    type Output = Self;

    #[intrinsic]
    fn add(self, other: Self) -> Output;
}

impl Zero for int {
    fn zero() -> Self {
        0
    }
}

enum Option<T> {
    Some(T),
    None
}

use Option::*;

trait Default {
    fn default() -> Self;
}

impl Default for Tree {
    fn default() {
        Self::new()
    }
}

struct Tree {
    root: TreeNode,
}

impl Tree {
    fn new() {
        Self {
            root: TreeNode::root()
        }
    }
}

struct TreeNode {
    parent: Option<TreeNode>,
    children: [TreeNode],
}

impl TreeNode {
    fn root() {
        Self {
            parent: None,
            children: []
        }
    }
}

fn id_add<T: Add>(x: T) {
    x
}

fn main() {
    let x: Add = 10;
    let y: Add<int> = 10;
    let out: int::Output = 73;
    let z = int::Output::add(18, 8);

    let zer = int::zero();

    let tree = Tree::new();
    let root = tree.root;

    let num = 43;
    let def: Default = tree;

    // TODO: Implement trait bounds.
    let id1 = id_add(tree);
    let id2 = id_add(y);
    
    // TODO: Support method calls directly on trait objects

    // TODO: Implement annotation collection and checking.
}
