trait Into<K> {
    fn into(self) -> K;
}

impl bool {
    fn then(f: Fn() -> ()) -> bool {
           
    }
}

impl Into<bool> for bool {
    fn into(self) -> Self {
        self
    }
}

impl Into<String> for String {
    fn into(self) -> String {
        self
    }
}

impl<T> Into<T> for String {
    fn into(self) -> T {
        self
    }
}

impl<T> Into<T> for T {
    fn into(self) -> T {
        self
    }
}

fn check(thing: Into<String>) -> String {
    return "Hello";
}

fn main() {
    let x: Into<[int]> = [10];

    let eg: Into<([int], Fn() -> ())> = "10";
    let edge: Into<int> = "10";

    check("10");
}
