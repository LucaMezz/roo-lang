trait Into<K> {
    fn into(self) -> K;
}

impl bool {
    fn then(f: Fn() -> ()) -> bool {
           
    }
}

impl<T> Into<T> for T {
    fn into(self) -> T {
        self
    }
}

impl<T> Into<T> for String {
    fn into(self) -> T {
        self as T;
    }
}

fn check(thing: Into<String>) -> String {
    return "Hello";
}

fn main() {
    let x: Into<[int]> = [10];
    let x: Into<[int]> = 0;

    let x: Into<bool> = "Hello World";

    check("10");
}
