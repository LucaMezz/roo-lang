trait Into<K> {
    fn into() -> K;
}

impl bool {
    fn then(f: Fn() -> ()) -> bool {
           
    }
}

impl Into<bool> for bool {
    fn into() -> bool {
        true
    }
}

impl Into<String> for String {
    fn into() -> String {
        ""
    }
}

impl<T> Into<T> for String {
    fn into() -> T {
        ""
    }
}

impl<T> Into<T> for T {
    fn into() -> T {
        self
    }
}

fn check(thing: Into<String>) -> String {
    return "Hello";
}

fn main() {
    let x: Into<[int]> = [10];

    let eg: Into<([int], Fn() -> ())> = "10";

    check(x);
}
