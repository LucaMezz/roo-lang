
trait Add<Rhs = Self> {
    type Output;

    fn add(self, other: Rhs) -> Output;
}

impl Add for int {
    type Output = Self;

    #[intrinsic]
    fn add(self, other: Self) -> Output;
}

trait Sub<Rhs = Self> {
    type Output;

    fn sub(self, other: Rhs) -> Output;
}

impl Sub for int {
    type Output = Self;

    #[intrinsic]
    fn sub(self, other: Self) -> Output;
}

fn add<T: Add<T> + Sub<T> >(x: T, y: T) -> T::Output {
    <T as Add>::add(x, y);
}

fn main() {
    add(10, 12);
}
