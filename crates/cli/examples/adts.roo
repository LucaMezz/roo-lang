
enum Expr<T> {
    Add(Expr<T>, Expr<T>),
    Int
}

#[allow(unused)]
struct Vector2<T> {
    x: T,
    y,
}

#[extern(no)]
struct Unit;

struct Handle(int, Vector2);

enum Option<T> {
    Some(T),
    Multi { x: T, y },
    None,
    Fixed(int)
}

use Option::*;

fn main() {
    let x;
    let zero: Vector2 = Vector2 { x, y: 0.0 };
    let zilch: float = 0.0;
    let y = 10;
    let coord: Vector2 = Vector2 { x: 10.2, y };

    let example: Vector2<bool, bool> = Vector2 { x: true, y: false };

    let sample: Unit = Unit;

    let standard: Handle = Handle(1, zero);

    let result = None;
    let result2 = Some("Hello");
    let result3 = Option::Multi { x: "Hello", y: 10 };
    let result4 = Option::Fixed(10);
}
