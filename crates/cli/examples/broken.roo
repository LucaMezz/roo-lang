
pub type List<T> = [T];

mod utilities {
    pub type Pair<T, U> = (T, U);

    fn pair(a, b) {
        (a, b)
    }

    mod special {
        type Double<H, J> = (J, H);
    }
}


fn main() -> () {
    let something = apply(id); 
}

fn apply(f) {
    fn to(x) {
        f(x)
    }
    to
}

fn id(x) {
    x
}

use utilities::{Pair, pair, special::*};

fn build() -> Pair<int, bool> {
    let combo: Double = pair::<int, bool>(10, true);
}
