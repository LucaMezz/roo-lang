//! A loose, mostly-untyped inventory/dialogue script — the "quick
//! throwaway script" end of fig, deliberately leaning on gradual typing
//! instead of the heavier trait/generic machinery the other examples use.
//!
//! Exercises: unannotated bindings/fields/parameters, the explicit `any`
//! type, dynamic arrays, closures with untyped parameters, and the
//! typed/untyped boundary (a dynamic value flowing into a statically
//! typed function, checked at the call).

// Every item carries wildly different extra data depending on `kind` — a
// weapon has damage, a potion has heal_amount, a key has nothing at all.
// That's exactly the case gradual typing is for: no shared shape to give
// a static type to, so `data` is left untyped on purpose, not because
// anyone forgot an annotation.
struct Item {
    name: String,
    kind: String,
    data,
}

let sword = Item { name: "Sword", kind: "weapon", data: 12 };
let potion = Item { name: "Potion", kind: "potion", data: 25 };
let key = Item { name: "Rusty Key", kind: "key", data: () };

// A dynamically-typed array — every element is checked individually at
// use, not against one shared element type.
let inventory: [Item] = [sword, potion, key];

// Fully statically typed, unlike almost everything around it.
fn heal(current: int, amount: int) -> int {
    current + amount
}

fn use_item(mut health: int, item: Item) -> int {
    if item.kind == "potion" {
        // `item.data` is dynamically typed; `heal` is not. This is the
        // boundary-crossing case from gradual-typing.md: allowed here
        // with no complaint, and would only fail at this call if
        // `item.data` didn't actually hold an int at runtime.
        health = heal(health, item.data);
    }
    health
}

// `any` written explicitly: `selected` would otherwise infer to `String`
// from its first assignment and get locked there — `any` opts it out, on
// purpose, since it's meant to hold whichever item's name was clicked on
// last, or nothing at all yet.
let mut selected: any = "";

// This has to be a closure, not a plain `fn` — a plain `fn` is hoisted
// (visible throughout this file, even above this point), and `selected`
// only exists from its own `let` onward, so a hoisted `fn` couldn't
// capture it: there'd be no well-defined value if it were called before
// `selected`'s `let` runs. See closures.md's "Why fn and closures capture
// differently".
let select = |name: String| {
    selected = name;
};

// Closures with untyped parameters, stored uniformly regardless of what
// each one actually expects its argument to look like. Neither closure
// literal below declares its own return type either — both are
// dynamically-typed functions being stored into a concretely
// `Fn(any) -> ()`-typed slot, checked at the call, not at this
// assignment — see gradual-typing.md's "The same boundary applies to a
// function's return type".
let on_examine: Fn(any) -> () = |item| {
    print(item.name);
};

let on_use: Fn(any) -> () = |item| {
    print(item.kind);
};

let handlers: [Fn(any) -> ()] = [on_examine, on_use];

for item in inventory {
    select(item.name);
    for handler in handlers {
        handler(item);
    }
}

let mut health = 80;
for item in inventory {
    health = use_item(health, item);
}
print(health);
