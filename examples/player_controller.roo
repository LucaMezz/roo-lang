//! A smaller companion to ecs.roo: instead of a whole entity-component
//! system, this is the kind of single-object "controller" script you'd
//! attach directly to one game object — closer to how Roblox/Unity/Godot
//! scripting usually looks day to day.
//!
//! Exercises: bare-named lifecycle functions (`_ready`/`_update`) as one
//! possible entry-point convention a host could recognize — a module's
//! top level holds only items now, no executable statements, so
//! something outside roo has to decide where a script starts running;
//! see ecs.roo for an annotation-driven convention instead
//! (`#[setup]`/`#[system]`) and dialogue.roo for a marked-struct one.
//! Also: reusing ecs.roo's exact `engine` ambient module signatures for
//! consistency; an enum-driven state machine; annotations on enum
//! variants and a struct field — `#[replicated]`, `#[range(...)]`, and
//! `#[audio_cue = "..."]` below are all roo-engine's own vocabulary, not
//! a roo compiler feature (see ecs.roo for a compiler-defined one,
//! `#[must_use]`, and the book's Annotations chapter for the full
//! picture); and passing mutable state through an explicit function
//! parameter — the only option now, since there's no module-level
//! `let player` for `_update` to even try closing over. See
//! decisions/0009 for why hoisted `fn`s can never
//! capture `let` bindings regardless (only closures can), and
//! decisions/0017 for the still-open question of whether roo should
//! ever grow a way to share state like this without threading it
//! through every call.

mod engine {
    pub fn is_key_down(key: String) -> bool;
    pub fn delta_time() -> float;
    pub fn draw_circle(x: float, y: float, radius: float);
}

enum State {
    Idle,
    #[audio_cue = "footstep"]
    Walking,
    #[audio_cue = "jump"]
    Jumping,
}

// #[replicated] on the whole struct: roo-engine would sync every field to
// other clients in a multiplayer game. `#[range(...)]` below is
// unrelated — editor-facing metadata for an inspector slider, not
// anything to do with networking.
#[replicated]
struct Player {
    x: float,
    y: float,
    state: State,
    #[range(min = 0, max = 100)]
    health: int,
}

impl Player {
    fn new() -> Player {
        Player { x: 0.0, y: 0.0, state: State::Idle, health: 100 }
    }

    fn take_damage(self, amount: int) {
        self.health -= amount;
        if self.health <= 0 {
            print("player died");
        }
    }
}

fn move_speed_for(state: State) -> float {
    match state {
        State::Idle => 0.0,
        State::Walking => 4.0,
        State::Jumping => 6.0,
    }
}

// roo-engine calls this once, by name, to get the initial value it then
// threads into every `_update` call below — the bare-named-function
// counterpart to ecs.roo's `#[setup]`.
fn _ready() -> Player {
    Player::new()
}

// roo-engine calls this every frame, by name, passing back whatever the
// previous call (or `_ready`, on the first frame) left `player` holding.
fn _update(player: Player, dt: float) {
    let moving = engine::is_key_down("d") || engine::is_key_down("a");
    player.state = if engine::is_key_down("space") {
        State::Jumping
    } else if moving {
        State::Walking
    } else {
        State::Idle
    };

    let speed = move_speed_for(player.state);
    if engine::is_key_down("d") {
        player.x += speed * dt;
    } else if engine::is_key_down("a") {
        player.x -= speed * dt;
    }

    engine::draw_circle(player.x, player.y, 8.0);
}
